{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mv:*)",
      "Bash(make manifests:*)",
      "Bash(sed:*)",
      "Bash(kind delete cluster:*)",
      "Bash(docker exec:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl exec:*)",
      "Bash(kubectl delete:*)",
      "Bash(docker logs:*)",
      "Bash(helm show values:*)",
      "Bash(kubectl apply:*)"
    ],
    "deny": []
  }
}
